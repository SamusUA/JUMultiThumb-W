			                label="PLG_JUMULTITHUMB_THUMBNAILS_ALL_IMAGES"
	                 description="PLG_JUMULTITHUMB_HELP_RESALL">
	                    <option value="0">JNO</option>
	                    <option value="1">JYES</option>
	                </field>

		            <field name="note13"
		                   type="note"
		                   label=""
		                   description="PLG_JUMULTITHUMB_NOTICE0" />

                <field name="Only_For_First_Image" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="PLG_JUMULTITHUMB_ONLY_FOR_FIRST_IMAGE" description="PLG_JUMULTITHUMB_HELP_FIRST_IMAGE">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="only_image_blog" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="PLG_JUMULTITHUMB_ONLY_IMAGE" description="PLG_JUMULTITHUMB_HELP_ONLY_IMAGE_BLOG">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="only_image_category" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="PLG_JUMULTITHUMB_ONLY_IMAGE" description="PLG_JUMULTITHUMB_HELP_ONLY_IMAGE_CATEGORY">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="only_image_featured" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="PLG_JUMULTITHUMB_ONLY_IMAGE" description="PLG_JUMULTITHUMB_HELP_ONLY_IMAGE_FEATURED">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

	                <field
			                name="noimage_class"
			                type="text"
			                default=""
			                size="15"
			                label="PLG_JUMULTITHUMB_NOIMAGE_CUSTOM"
	                 description="PLG_JUMULTITHUMB_HELP_NOIMAGE_CLASS"/>

	                <field
			                name="quality"
			                type="text"
			                default="90"
			                class=""
			                size="2"
			                label="PLG_JUMULTITHUMB_QUALITY"
			                description="PLG_JUMULTITHUMB_HELP_QUALITY"
	                />

	                <field
			                name="thumb_filtercolor"
			                type="list"
			                default="0"
			                label="PLG_JUMULTITHUMB_IMAGE_FILTERS_SELECT_COLOR"
			                description="PLG_JUMULTITHUMB_HELP_FILTER_MODE"
	                >
	                    <option value="0">JNO</option>
	                    <option value="1">PLG_JUMULTITHUMB_IMAGE_FILTERS_GREY</option>
	                    <option value="2">PLG_JUMULTITHUMB_IMAGE_FILTERS_SEPIA</option>
	                    <option value="3">PLG_JUMULTITHUMB_FILTER_TH</option>
	                    <option value="4">PLG_JUMULTITHUMB_IMAGE_FILTERS_CUSTOM</option>
	                </field>

