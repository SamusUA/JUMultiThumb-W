			                description="PLG_JUMULTITHUMB_HELP_FILTER_STRENGTH"
			                showon="thumb_filtercolor:4"
	                />

	                <field
			                name="colorpicker"
			                type="color"
			                default="#0000ff"
			                label="PLG_JUMULTITHUMB_IMAGE_FILTERS_COLOR"
			                description="PLG_JUMULTITHUMB_HELP_FILTER_COLOR"
			                showon="thumb_filtercolor:4"
	                />

	                <field
			                name="thumb_th_seting"
			                type="integer"
			                default="10"
			                label="PLG_JUMULTITHUMB_CHOOSE_AN_INTEGER"
			                description="PLG_JUMULTITHUMB_HELP_FILTER_THRESHOLD"
			                first="0"
			                last="255"
			                step="5"
			                showon="thumb_filtercolor:3"
	                />

	                <field
			                name="thumb_filters"
			                type="radio"
			                layout="joomla.form.field.radio.switcher"
			                default="1"
			                label="PLG_JUMULTITHUMB_USE_FILTERS"
	                 description="PLG_JUMULTITHUMB_HELP_FILTERS_ENABLE">
	                    <option value="0">JNO</option>
	                    <option value="1">JYES</option>
	                </field>

	                <field
			                name="thumb_unsharp"
			                type="radio"
			                layout="joomla.form.field.radio.switcher"
			                default="1"
			                label="PLG_JUMULTITHUMB_FILTER_UNSHARP"
			                showon="thumb_filters:1"
	                 description="PLG_JUMULTITHUMB_HELP_UNSHARP_ENABLE">
	                    <option value="0">JNO</option>
	                    <option value="1">JYES</option>
	                </field>

	                <field
			                name="thumb_unsharp_amount"
			                type="integer"
			                default="80"
			                label="PLG_JUMULTITHUMB_FILTER_UNSHARP_AMOUNT"
			                description="PLG_JUMULTITHUMB_HELP_UNSHARP_AMOUNT"
			                first="0"
			                last="255"
			                step="5"
			                showon="thumb_filters:1[AND]thumb_unsharp:1"
	                />

	                <field
			                name="thumb_unsharp_radius"
			                type="integer"
			                default="1"
			                label="PLG_JUMULTITHUMB_FILTER_UNSHARP_RADIUS"
			                description="PLG_JUMULTITHUMB_HELP_UNSHARP_RADIUS"
			                first="0"
			                last="10"
			                step="1"
			                showon="thumb_filters:1[AND]thumb_unsharp:1"
	                />

	                <field
			                name="thumb_unsharp_threshold"
			                type="integer"
			                default="3"
			                label="PLG_JUMULTITHUMB_FILTER_UNSHARP_THRESHOLD"
			                description="PLG_JUMULTITHUMB_HELP_UNSHARP_THRESHOLD"
			                first="0"
			                last="50"
			                step="1"
			                showon="thumb_filters:1[AND]thumb_unsharp:1"
	                />

	                <field
			                name="thumb_blur"
			                type="radio"
			                layout="joomla.form.field.radio.switcher"
			                default="0"
			                label="PLG_JUMULTITHUMB_FILTER_BLUR"
			                showon="thumb_filters:1"
	                 description="PLG_JUMULTITHUMB_HELP_BLUR_ENABLE">
	                    <option value="0">JNO</option>
	                    <option value="1">JYES</option>
	                </field>

	                <field
			                name="thumb_blur_seting"
			                type="integer"
			                default="1"
			                label="PLG_JUMULTITHUMB_CHOOSE_AN_INTEGER"
			                description="PLG_JUMULTITHUMB_HELP_BLUR_AMOUNT"
			                first="1"
			                last="5"
			                step="1"
			                showon="thumb_filters:1[AND]thumb_blur:1"
	                />

	                <field
			                name="thumb_brit"
			                type="radio"
			                layout="joomla.form.field.radio.switcher"
			                default="0"
			                label="PLG_JUMULTITHUMB_FILTER_BRIT"
			                showon="thumb_filters:1"
	                 description="PLG_JUMULTITHUMB_HELP_BRIGHTNESS_ENABLE">
	                    <option value="0">JNO</option>
	                    <option value="1">JYES</option>
	                </field>

	                <field
			                name="thumb_brit_seting"
			                type="integer"
			                default="50"
			                label="PLG_JUMULTITHUMB_CHOOSE_AN_INTEGER"
			                description="PLG_JUMULTITHUMB_HELP_BRIGHTNESS_AMOUNT"
			                first="-50"
			                last="50"
			                step="2"
			                showon="thumb_filters:1[AND]thumb_brit:1"
	                />

	                <field
			                name="thumb_cont"
			                type="radio"
			                layout="joomla.form.field.radio.switcher"
			                default="0"
			                label="PLG_JUMULTITHUMB_FILTER_CONT"
			                showon="thumb_filters:1"
	                 description="PLG_JUMULTITHUMB_HELP_CONTRAST_ENABLE">
	                    <option value="0">JNO</option>
	                    <option value="1">JYES</option>
	                </field>

	                <field
			                name="thumb_cont_seting"
			                type="integer"
			                default="50"
			                label="PLG_JUMULTITHUMB_CHOOSE_AN_INTEGER"
			                description="PLG_JUMULTITHUMB_HELP_CONTRAST_AMOUNT"
			                first="-50"
			                last="50"
			                step="2"
			                showon="thumb_filters:1[AND]thumb_cont:1"
	                />

