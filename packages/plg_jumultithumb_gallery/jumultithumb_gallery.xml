    <version>6.0.14-beta</version>
    <description>PLG_JUMULTITHUMB_XML_DESCRIPTION</description>

    <files>
        <folder>services</folder>
        <filename plugin="jumultithumb_gallery">jumultithumb_gallery.php</filename>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.plg_content_jumultithumb_gallery.ini</language>
        <language tag="en-GB">en-GB/en-GB.plg_content_jumultithumb_gallery.sys.ini</language>
        <language tag="uk-UA">uk-UA/uk-UA.plg_content_jumultithumb_gallery.ini</language>
        <language tag="uk-UA">uk-UA/uk-UA.plg_content_jumultithumb_gallery.sys.ini</language>
    </languages>

    <config addfieldpath="/plugins/content/jumultithumb/fields/">

        <fields name="params"
                addfieldpath="/plugins/content/jumultithumb/fields/">

            <fieldset name="BASIC">

                <field
		                name="useimgagegallery"
		                type="radio"
		                layout="joomla.form.field.radio.switcher"
		                default="1"
		                label="PLG_JUMULTITHUMB_USEIMAGEGALLERY"
                 description="PLG_JUMULTITHUMB_GALLERY_HELP_DISPLAY">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
		                name="width"
		                type="text"
		                default="130"
		                size="4"
		                label="PLG_JUMULTITHUMB_WIDTH"
		                description="PLG_JUMULTITHUMB_GALLERY_HELP_THUMB_WIDTH"
		                showon="useimgagegallery:1"
                />

                <field
		                name="height"
		                type="text"
		                default="130"
		                size="4"
		                label="PLG_JUMULTITHUMB_HEIGHT"
		                description="PLG_JUMULTITHUMB_GALLERY_HELP_THUMB_HEIGHT"
		                showon="useimgagegallery:1"
                />

                <field
		                name="cropzoom"
		                type="radio"
		                layout="joomla.form.field.radio.switcher"
		                default="1"
		                label="PLG_JUMULTITHUMB_CROP_IMAGE"
		                showon="useimgagegallery:1"
                 description="PLG_JUMULTITHUMB_GALLERY_HELP_THUMB_CROP">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field type="spacer"
                       name="gall"
                       class="text-left"
                       label="PLG_JUMULTITHUMB_GALLERY_READMORE" />

                <field
		                name="galleryfolder"
		                type="folderlist"
		                default=""
		                label="PLG_JUMULTITHUMB_GALLERY_FOLDER"
		                description="PLG_JUMULTITHUMB_GALLERY_HELP_FOLDER"
		                directory="images"
		                exclude="files|jursspublisher|tmp"
		                hide_none="1"
		                hide_default="1"
                />

                <field
		                name="gallwidth"
		                type="text"
		                default="130"
		                size="4"
		                label="PLG_JUMULTITHUMB_WIDTH"
		                description="PLG_JUMULTITHUMB_GALLERY_HELP_FOLDER_WIDTH"
                />

                <field name="gallheight"
                       type="text"
                       default="130"
                       size="4"
                       label="PLG_JUMULTITHUMB_HEIGHT"
                       description="PLG_JUMULTITHUMB_GALLERY_HELP_FOLDER_HEIGHT" />

                <field name="gallcropzoom"
                       type="radio"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="PLG_JUMULTITHUMB_CROP_IMAGE" description="PLG_JUMULTITHUMB_GALLERY_HELP_FOLDER_CROP">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

